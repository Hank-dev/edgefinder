ENVIRONMENT=production
APP_NAME=Edgefinder
APP_PORT=8787
DATABASE_URL=sqlite:////app/data/edgefinder.db
DATA_DIR=/app/data
BACKUP_DIR=/app/backups
AGENT_TOKEN=replace-with-a-long-random-value
INTERNAL_TOKEN=replace-with-a-different-long-random-value
PUBLIC_BASE_URL=http://127.0.0.1:8787
TIMEZONE=Europe/Oslo
WEEKLY_BUDGET_EUR=7
MAX_SIGNALS_PER_RUN=120
MAX_CANDIDATES_PER_RUN=12
MAX_DEEP_REVIEWS=8
RETENTION_BACKUPS=30
MAX_RUN_AGE_HOURS=48
COLLECTION_USER_AGENT=Edgefinder/0.1 (+private research; contact=you@example.com)
# Who executes on the findings. Given to the research agents so ranking matches what you can actually do.
OPERATOR_PROFILE=Solo full-stack developer in Norway; roughly 10 hours per week; prefers low-capital software wedges.

# Optional public API credentials. A missing source fails visibly without stopping others.
GITHUB_TOKEN=
# pam-stilling-feed token: https://pam-stilling-feed.nav.no/api/publicToken (rotates), or request a private token from NAV.
NAV_API_TOKEN=

# Comma-separated public RSS/Atom feeds to add without code changes.
# Note: Reddit rejects non-browser clients regardless of URL; it needs an OAuth adapter, not a feed entry.
EXTRA_FEED_URLS=

