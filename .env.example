ENVIRONMENT=production
APP_NAME=Edgefinder
APP_PORT=8787
DATABASE_URL=sqlite:////app/data/edgefinder.db
DATA_DIR=/app/data
BACKUP_DIR=/app/backups
AGENT_TOKEN=replace-with-a-long-random-value
INTERNAL_TOKEN=replace-with-a-different-long-random-value
PUBLIC_BASE_URL=http://127.0.0.1:8787
TIMEZONE=Europe/Oslo
WEEKLY_BUDGET_EUR=7
MAX_SIGNALS_PER_RUN=120
MAX_CANDIDATES_PER_RUN=12
MAX_DEEP_REVIEWS=8
RETENTION_BACKUPS=30
COLLECTION_USER_AGENT=Edgefinder/0.1 (+private research; contact=you@example.com)

# Optional public API credentials. A missing source fails visibly without stopping others.
GITHUB_TOKEN=
NAV_API_TOKEN=

# Comma-separated public RSS/Atom feeds to add without code changes.
EXTRA_FEED_URLS=

